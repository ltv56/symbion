DB_NAME=symbion
DB_USER=symbion
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_PORT=3306
API_PORT=3000
# prod profile: public host name; the certificate is read from /etc/letsencrypt/live/$DOMAIN
DOMAIN=change-me
# host-side scripts and tests; the api container uses DB_HOST=mysql from compose
DB_HOST=127.0.0.1
MAX_POINTS_PER_ORDER=10000
ADMIN_EMAIL=admin@example.com
# create with: printf '%s' '<password>' | pnpm --silent --filter @symbion/api hash-password
# keep the single quotes: the value contains $, which Compose expands otherwise
ADMIN_PASSWORD_HASH='change-me'
# at least 32 characters
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=1h
# true: POST /auth/member/otp returns the code (no email sending yet)
DEMO_MODE=false
# email for the sign-in and sign-up codes; leave SMTP_HOST empty to send nothing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# true: wipe and reseed the demo data every night; needs DEMO_MODE=true and DEMO_API_KEY (16+ characters)
DEMO_RESET=false
# DEMO_API_KEY=
# shown by GET /demo/accounts; must be the password behind ADMIN_PASSWORD_HASH (the api refuses to start otherwise)
# DEMO_ADMIN_PASSWORD=
