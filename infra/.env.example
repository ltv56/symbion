DB_NAME=symbion
DB_USER=symbion
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
DB_PORT=3306
API_PORT=3000
# host-side scripts and tests; the api container uses DB_HOST=mysql from compose
DB_HOST=127.0.0.1
MAX_POINTS_PER_ORDER=10000
ADMIN_EMAIL=admin@example.com
# create with: printf '%s' '<password>' | pnpm --silent --filter @symbion/api hash-password
ADMIN_PASSWORD_HASH=change-me
# at least 32 characters
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=1h
